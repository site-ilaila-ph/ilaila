{
  "github.copilot.nextEditSuggestions.enabled": false,
  "git.enableSmartCommit": true,
  "chat.agentFilesLocations": {
    ".agents/white": true,
    ".agents/black": true
  },
  "chat.agentSkillsLocations": {
    ".agents/white/skills": true,
    ".agents/black/skills": true
  },
  "chat.viewSessions.enabled": false,
  "gitlens.graph.details.location": "auto",
  "github.copilot.enable": {
    "markdown": false,
    "*": false,
    "dotenv": false,
    "plaintext": false,
    "scminput": false
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "window.density.layout": "compact",
  "chat.byokUtilityModelDefault": "mainAgent",
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "explorer.confirmDragAndDrop": false,
  "terminal.integrated.initialHint": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "terminal.integrated.profiles.linux": {
    "Developer Bash": {
      "path": "bash",
      "args": ["--rcfile", ".vscode/Developer Bash.sh", "-i"],
      "icon": "terminal-bash"
    },
    "Developer Powershell": {
      "path": "pwsh",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".vscode/Developer Powershell.ps1"],
      "icon": "terminal-powershell"
    }
  },
  "terminal.integrated.defaultProfile.linux": "Developer Bash"
}
