{
  "github.copilot.nextEditSuggestions.enabled": false,
  "git.enableSmartCommit": true,
  "chat.agentFilesLocations": {
    ".agents": true
  },
  "chat.agentSkillsLocations": {
    ".agents/skills": true
  },
  "gitlens.graph.details.location": "auto",
  "github.copilot.enable": {
    "markdown": false,
    "*": false,
    "dotenv": false,
    "plaintext": false,
    "scminput": false
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "window.density.layout": "compact",
  "chat.byokUtilityModelDefault": "mainAgent",
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "explorer.confirmDragAndDrop": false,
  "terminal.integrated.initialHint": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "js/ts.tsserver.experimental.enableProjectDiagnostics": true,
  "terminal.integrated.profiles.windows": {
    "Developer Powershell": {
      "path": "powershell",
      "args": [
        "-NoExit",
        "-File",
        "${workspaceFolder}/.vscode/Developer Powershell Environment.ps1"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "Developer Powershell",
  "terminal.integrated.automationProfile.windows": {
    "path": "powershell",
    "args": [
      "-NoExit",
      "-File",
      "${workspaceFolder}/.vscode/Developer Powershell Environment.ps1"
    ]
  },
  "chat.tools.terminal.terminalProfile.windows": {
    "path": "powershell",
    "args": [
      "-NoExit",
      "-File",
      "${workspaceFolder}/.vscode/Developer Powershell Environment.ps1"
    ]
  },
  "js/ts.tsdk.path": "node_modules\\typescript\\lib"
}
