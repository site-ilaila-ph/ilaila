{
  "files.exclude": {
    // base ignore.
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true

    // normally we should not be editing these files.
    // ".github": true,
    // ".pnpm-store": true,
    // "node_modules": true,
    // ".next": true
  },

  "files.associations": {
    "*.json5": "jsonc"
  },

  "chat.agentFilesLocations": {
    ".github/agents": false,
    ".agents/": true
  },

  "chat.agentSkillsLocations": {
    ".github/skills": false,
    ".agents/skills": true
  },
  
  "js/ts.tsdk.path": "node_modules/typescript/lib",
}
