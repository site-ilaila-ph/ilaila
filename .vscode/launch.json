{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: App (Dev - Server)",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm app:dev",
      "preLaunchTask": "Application Setup",
      "postDebugTask": "Application Teardown",
      "env": {
        "NODE_ENV": "development"
      },
      "serverReadyAction": {
        "action": "startDebugging",
        "name": "Debug: App (Dev - Client)",
        "pattern": "Local:\\s+http://localhost:(\\d+)",
        "killOnServerStop": true
      }
    },
    {
      "name": "Debug: App (Dev - Client)",
      "type": "chrome",
      "request": "launch",
      "webRoot": "${workspaceFolder}",
      "userDataDir": "${workspaceFolder}/.tmp/chrome-dev-user",
      "url": "http://localhost:3000",
      "sourceMaps": true,
      "timeout": 180000
    }
  ]
}