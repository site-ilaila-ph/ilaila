{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug: App",
        "type": "node-terminal",
        "request": "launch",
        "command": "pnpm dev",
        "serverReadyAction": {
          "action": "startDebugging",
          "name": "Debug: App (Dev - Client)",
          "pattern": "prisma-dev ready!",
          "killOnServerStop": true
        }
      },
      {
        "name": "Debug: App (Dev - Client)",
        "type": "chrome",
        "request": "launch",
        "webRoot": "${workspaceFolder}",
        "userDataDir": "${workspaceFolder}/.tmp/chrome-dev-user",
        "url": "http://localhost:3000",
        "sourceMaps": true,
        "timeout": 180000
      }
    ]
  }