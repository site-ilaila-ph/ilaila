model IcebergTable {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  namespaceId      String            @map("namespace_id") @db.Uuid
  bucketName       String            @map("bucket_name")
  name             String
  location         String            @unique(map: "idx_iceberg_tables_location")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  remoteTableId    String?           @map("remote_table_id")
  shardKey         String?           @map("shard_key")
  shardId          String?           @map("shard_id")
  catalogId        String            @map("catalog_id") @db.Uuid
  bucketAnalytics  BucketAnalytics   @relation(fields: [catalogId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  icebergNamespace IcebergNamespace  @relation(fields: [namespaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([catalogId, namespaceId, name], map: "idx_iceberg_tables_namespace_id")
  @@map("iceberg_tables")
  @@schema("storage")
}