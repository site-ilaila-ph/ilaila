model IcebergNamespace {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bucketName       String            @map("bucket_name")
  name             String
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  metadata         Json              @default("{}")
  catalogId        String            @map("catalog_id") @db.Uuid
  bucketAnalytics  BucketAnalytics   @relation(fields: [catalogId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  icebergTables    IcebergTable[]

  @@unique([catalogId, name], map: "idx_iceberg_namespaces_bucket_id")
  @@map("iceberg_namespaces")
  @@schema("storage")
}