model S3MultipartUploadPart {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadId           String              @map("upload_id")
  size               BigInt              @default(0)
  partNumber         Int                 @map("part_number")
  bucketId           String              @map("bucket_id")
  key                String
  etag               String
  ownerId            String?             @map("owner_id")
  version            String
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  bucket             Bucket              @relation(fields: [bucketId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  s3MultipartUpload  S3MultipartUpload   @relation(fields: [uploadId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("s3_multipart_uploads_parts")
  @@schema("storage")
}