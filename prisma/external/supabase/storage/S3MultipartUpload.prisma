model S3MultipartUpload {
  id                        String                        @id
  inProgressSize            BigInt                        @default(0) @map("in_progress_size")
  uploadSignature           String                        @map("upload_signature")
  bucketId                  String                        @map("bucket_id")
  key                       String
  version                   String
  ownerId                   String?                       @map("owner_id")
  createdAt                 DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  userMetadata              Json?                         @map("user_metadata")
  metadata                  Json?
  bucket                    Bucket                        @relation(fields: [bucketId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  s3MultipartUploadParts    S3MultipartUploadPart[]

  @@index([bucketId, key, createdAt], map: "idx_multipart_uploads_list")
  @@map("s3_multipart_uploads")
  @@schema("storage")
}