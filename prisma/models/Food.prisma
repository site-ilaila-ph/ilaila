model Food {
  id                   String         @id @default(uuid()) @db.Uuid
  name                 String
  description          String
  history              String
  preparation          String
  recipe               String
  culturalSignificance String
  isHeritage           Boolean

  businesses           BusinessFood[]
  images               FoodImage[]
  tags                 FoodTag[]

  @@map("foods")
  @@schema("app")
}