generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userName     String?
  email        String   @unique
  passwordHash String
  isAdmin      Boolean  @default(false)

  appReviews       AppReview[]
  bookmarks        Bookmark[]
  businessesPosted Business[]
  reviews          Review[]
  
  @@map("User")
}

model Food {
  id                   String  @id @default(cuid())
  name                 String
  description          String
  history              String
  preparation          String
  recipe               String
  culturalSignificance String
  isHeritage           Boolean

  businesses BusinessFood[]
  images     FoodImage[]
  tags       FoodTag[]

  @@map("Food")
}

model FoodTag {
  id     String @id @default(cuid())
  value  String
  foodId String

  food Food @relation(fields: [foodId], references: [id])

  @@map("FoodTag")
}

model FoodImage {
  id          String  @id @default(cuid())
  foodId      String
  description String
  url         String?

  food Food @relation(fields: [foodId], references: [id])

  @@map("FoodImage")
}

model Business {
  id          String   @id @default(cuid())
  name        String
  description String
  history     String?
  isPublished Boolean  @default(true)
  createdById String
  address     String
  latitude    Float
  longitude   Float
  hours       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookmarks Bookmark[]
  createdBy User            @relation(fields: [createdById], references: [id])
  foods     BusinessFood[]
  images    BusinessImage[]
  tags      BusinessTag[]
  menuItems MenuItem[]
  reviews   Review[]

  @@map("Business")
}

model BusinessImage {
  id          String @id @default(cuid())
  businessId  String
  description String
  url         String?

  business Business @relation(fields: [businessId], references: [id])

  @@map("BusinessImage")
}

model BusinessTag {
  id         String @id @default(cuid())
  value      String
  businessId String

  business Business @relation(fields: [businessId], references: [id])

  @@map("BusinessTag")
}

model MenuItem {
  id          String  @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal
  isAvailable Boolean @default(true)
  dietaryTags String[]

  business Business @relation(fields: [businessId], references: [id])

  @@map("MenuItem")
}

model BusinessFood {
  id         String @id @default(cuid())
  businessId String
  foodId     String

  business Business @relation(fields: [businessId], references: [id])
  food     Food     @relation(fields: [foodId], references: [id])

  @@unique([businessId, foodId])
  @@map("BusinessFood")
}

model Review {
  id          String   @id @default(cuid())
  userId      String
  businessId  String
  text        String
  foodQuality Int
  service     Int
  ambiance    Int
  value       Int
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, businessId])
  @@map("Review")
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userId, businessId])
  @@map("Bookmark")
}

model AppReview {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  email      String?
  rating     Int      @default(5)
  text       String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([isApproved])
  @@index([createdAt])
  @@map("AppReview")
}