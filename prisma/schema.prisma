model Business {
  id          String          @id @default(cuid())
  name        String
  description String
  history     String?
  isPublished Boolean         @default(true)
  createdById String
  address     String
  latitude    Float
  longitude   Float
  hours       String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  bookmarks   Bookmark[]
  createdBy   User            @relation(fields: [createdById], references: [id])
  foods       BusinessFood[]
  images      BusinessImage[]
  tags        BusinessTag[]
  menuItems   MenuItem[]
  reviews     Review[]
}

