// ============================================================
// APP SCHEMA
// ============================================================

enum UserRole {
  viewer
  admin

  @@map("user_role")
  @@schema("app")
}

model UserData {
  id               String      @id @db.Uuid
  authId           String      @db.Uuid
  authUser         User        @relation(fields: [authId], references: [id])
  role             UserRole    @default(viewer)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt @default(now())

  appReviews       AppReview[]
  bookmarks        Bookmark[]
  businessesPosted Business[]
  reviews          Review[]
  uploads          Upload[]

  @@unique([authId])
  @@index([authId])
  @@map("user_data")
  @@schema("app")
}

model Upload {
    id         String   @id @default(uuid()) @db.Uuid
    pathname   String
    uploadName String
    userId     String   @db.Uuid
    status     String   @default("pending")
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    user UserData @relation(fields: [userId], references: [id])

    @@index([userId])
    @@index([status])
    @@map("uploads")
    @@schema("app")
}

model Food {
  id                   String         @id @default(uuid()) @db.Uuid
  name                 String
  description          String
  history              String
  preparation          String
  recipe               String
  culturalSignificance String
  isHeritage           Boolean

  businesses           BusinessFood[]
  images               FoodImage[]
  tags                 FoodTag[]

  @@map("foods")
  @@schema("app")
}

model FoodTag {
  id     String @id @default(uuid()) @db.Uuid
  value  String
  foodId String @db.Uuid
  food   Food   @relation(fields: [foodId], references: [id])

  @@map("food_tags")
  @@schema("app")
}

model FoodImage {
  id          String  @id @default(uuid()) @db.Uuid
  foodId      String  @db.Uuid
  description String
  url         String?

  food        Food @relation(fields: [foodId], references: [id])

  @@map("food_images")
  @@schema("app")
}

model Business {
  id          String          @id @default(uuid()) @db.Uuid
  name        String
  description String
  history     String?
  isPublished Boolean         @default(true)
  createdById String          @db.Uuid
  address     String
  latitude    Float
  longitude   Float
  hours       String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt @default(now())

  bookmarks   Bookmark[]
  createdBy   UserData        @relation(fields: [createdById], references: [id])
  foods       BusinessFood[]
  images      BusinessImage[]
  tags        BusinessTag[]
  menuItems   MenuItem[]
  reviews     Review[]

  @@map("businesses")
  @@schema("app")
}

model BusinessImage {
  id          String  @id @default(uuid()) @db.Uuid
  businessId  String  @db.Uuid
  description String
  url         String?

  business    Business @relation(fields: [businessId], references: [id])

  @@map("business_images")
  @@schema("app")
}

model BusinessTag {
  id         String   @id @default(uuid()) @db.Uuid
  value      String
  businessId String   @db.Uuid

  business   Business @relation(fields: [businessId], references: [id])

  @@map("business_tags")
  @@schema("app")
}

model MenuItem {
  id          String   @id @default(uuid()) @db.Uuid
  businessId  String   @db.Uuid
  name        String
  description String?
  price       Decimal
  isAvailable Boolean  @default(true)

  business    Business @relation(fields: [businessId], references: [id])

  @@map("menu_items")
  @@schema("app")
}

model BusinessFood {
  id         String   @id @default(uuid()) @db.Uuid
  businessId String   @db.Uuid
  foodId     String   @db.Uuid

  business   Business @relation(fields: [businessId], references: [id])
  food       Food     @relation(fields: [foodId], references: [id])

  @@unique([businessId, foodId])
  @@map("business_foods")
  @@schema("app")
}

model Review {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  businessId  String   @db.Uuid
  text        String
  foodQuality Int
  service     Int
  ambiance    Int
  value       Int
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())

  business    Business @relation(fields: [businessId], references: [id])
  user        UserData @relation(fields: [userId], references: [id])

  @@unique([userId, businessId])
  @@map("reviews")
  @@schema("app")
}

model Bookmark {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  businessId String   @db.Uuid
  createdAt  DateTime @default(now())

  business   Business @relation(fields: [businessId], references: [id])
  user       UserData @relation(fields: [userId], references: [id])

  @@unique([userId, businessId])
  @@map("bookmarks")
  @@schema("app")
}

model AppReview {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String?   @db.Uuid
  userName   String?
  email      String?
  rating     Int       @default(5)
  text       String
  isApproved Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt @default(now())

  user       UserData? @relation(fields: [userId], references: [id])

  @@index([isApproved])
  @@index([createdAt])
  @@map("app_reviews")
  @@schema("app")
}
