{
  "name": "ilaila",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "app:dev": "next dev",
    "app:lint": "eslint --cache",
    "app:setup": "pnpm install && pnpm app:typegen",
    "app:start": "next start",
    "app:test": "vitest run",
    "app:typecheck": "pnpm app:typegen && tsc --noEmit",
    "app:typegen": "next typegen && pnpm db:typegen",
    "app:validate": "pnpm app:lint && pnpm app:typecheck && pnpm app:test",
    "app:build": "pnpm app:typegen && next build",
    "db:dev": "prisma dev",
    "db:reset": "prisma migrate reset --force",
    "db:push": "prisma db push",
    "db:typegen": "prisma generate",
    "db:stop": "pnpm tsx scripts/prisma-stop.mts",
    "build": "pnpm app:build",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "pnpm tsx prisma/seed.mts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^7.9.1",
    "@shadcn/react": "^0.2.1",
    "@upstash/redis": "^1.38.2",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "path-to-regexp": "^8.4.2",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.8.0",
    "shadcn": "^4.13.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
