{
	"name": "ilaila",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"typegen:app": "next typegen",
		"typegen:db": "prisma generate",
		"typegen": "pnpm typegen:app && pnpm typegen:db",
		"dev:app": "next dev",
		"dev:db": "pnpm tsx scripts/prisma-dev.mts",
		"dev:setup": "pnpm typegen",
		"dev": "concurrently --kill-others-on-fail \"pnpm run dev:app\" \"pnpm run dev:db\"",
		"ci:typecheck": "pnpm run typegen:app && tsc --noEmit",
		"ci:lint": "eslint --cache",
		"ci:test": "vitest run",
		"ci:setup": "pnpm install --frozen-lockfile && pnpm typegen",
		"ci:checks": "pnpm run ci:typecheck && pnpm run ci:lint && pnpm run ci:test",
		"ci": "pnpm run ci:setup && pnpm run ci:checks",
		"cd:setup": "pnpm install --frozen-lockfile && pnpm typegen",
		"cd:app": "pnpm run cd:setup && pnpm next build",
		"cd:bootstrap": "tsx scripts/bootstrap.mts",
		"cd:db": "pnpm run cd:setup && pnpm exec prisma migrate deploy && pnpm run cd:bootstrap"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@hookform/resolvers": "^5.7.1",
		"@prisma/adapter-pg": "^7.0.0",
		"@prisma/client": "^7.0.0",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-slot": "^1.3.3",
		"@shadcn/react": "^0.2.1",
		"@supabase/ssr": "^0.12.6",
		"@supabase/supabase-js": "^2.115.0",
		"@upstash/redis": "^1.38.2",
		"@vercel/blob": "^2.8.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"lucide-react": "^1.25.0",
		"motion": "^13.2.0",
		"next": "16.2.11",
		"next-auth": "^4.24.14",
		"next-themes": "^0.4.6",
		"path-to-regexp": "^8.4.2",
		"react": "19.2.4",
		"react-day-picker": "^10.0.1",
		"react-dom": "19.2.4",
		"react-hook-form": "^7.82.0",
		"react-resizable-panels": "^4.12.2",
		"recharts": "3.8.0",
		"shadcn": "^4.13.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/fs-extra": "^11.0.4",
		"@types/node": "^20.19.43",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitejs/plugin-react": "^6.0.5",
		"babel-plugin-react-compiler": "1.0.0",
		"chokidar": "^5.0.0",
		"concurrently": "^10.0.3",
		"dotenv": "^17.4.2",
		"eslint": "^9",
		"eslint-config-next": "16.2.10",
		"execa": "^10.0.1",
		"fs-extra": "^11.4.0",
		"jsdom": "^30.0.1",
		"prettier": "3.9.6",
		"prisma": "^7.0.0",
		"supabase": "^2.116.0",
		"tailwindcss": "^4",
		"tsx": "^4.23.11",
		"typescript": "^5",
		"typescript-eslint": "^8.65.0",
		"vercel": "^59.11.2",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.10"
	},
	"packageManager": "pnpm@12.3.4"
}